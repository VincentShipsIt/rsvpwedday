# Postgres connection string used by Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/rsvpwedday"

# Password for /admin/login, compared in constant time
ADMIN_PASSWORD="change-me"

# Random secret used to sign the admin_session cookie (openssl rand -hex 32)
ADMIN_SESSION_SECRET="change-me"

# Public origin used to build invite links and calendar files, no trailing slash
APP_URL="http://localhost:3010"

# From address for outgoing mail, must be a verified Resend sender/domain
EMAIL_FROM="Couple Name <rsvp@example.com>"

# Optional: when unset, emails are logged to the console instead of sent
RESEND_API_KEY=""

# Optional: Vercel Blob read/write token, enables drag-and-drop photo uploads in the admin.
# When unset, the admin still accepts an image URL typed or pasted directly.
BLOB_READ_WRITE_TOKEN=""

# Optional: Replicate API token, enables the admin's "Generate illustration" buttons
# (google/nano-banana-2-lite). Needs BLOB_READ_WRITE_TOKEN too, since a generated image is
# copied into Blob storage before it is used. When unset, the buttons are hidden.
REPLICATE_API_TOKEN=""
