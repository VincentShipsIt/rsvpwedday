# Postgres connection string used by Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/rsvpwedday"

# Plaintext password checked against ADMIN_PASSWORD_HASH-free sha256 comparison for /admin/login
ADMIN_PASSWORD="change-me"

# Random secret used to sign the admin_session cookie (openssl rand -hex 32)
ADMIN_SESSION_SECRET="change-me"

# Public origin used to build invite links and calendar files, no trailing slash
APP_URL="http://localhost:3010"

# From address for outgoing mail, must be a verified Resend sender/domain
EMAIL_FROM="Couple Name <rsvp@example.com>"

# Optional: when unset, emails are logged to the console instead of sent
RESEND_API_KEY=""
