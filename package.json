		"cn": "^0.2.5",
		"dotenv": "17.4.2",
		"lucide-react": "^1.41.0",
		"next": "16.3.4",
		"pg": "8.23.0",
		"radix-ui": "^1.6.7",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"resend": "6.26.0",
		"shadcn": "^4.21.0",
		"sonner": "^2.0.8",
		"tw-animate-css": "^1.4.0",
		"zod": "4.5.4"
	},
	"devDependencies": {
