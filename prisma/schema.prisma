datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum Locale {
  en
  de
  ku
}

enum GuestKind {
  ADULT
  CHILD
}

enum Attendance {
  PENDING
  ACCEPTED
  DECLINED
}

enum EmailKind {
  INVITE
  REMINDER
  CONFIRMATION
}

enum SiteTheme {
  EDITORIAL
  MODERN
  GARDEN
  MIDNIGHT
  BOHO
  VINTAGE
}

/// The first-load cover a guest sees before the page (see `src/components/site/opening`).
/// `NONE` skips it entirely; the other three are alternative SVG animations of the same cover.
enum OpeningAnimation {
  NONE
  SEAL
  MONOGRAM
  BLOOM
}

model Settings {
  id           Int      @id @default(1)
  coupleNames  String
  rsvpDeadline DateTime
  replyTo      String?
  updatedAt    DateTime @updatedAt
}

model Event {
  id           String             @id @default(cuid())
  slug         String             @unique
  startsAt     DateTime
  endsAt       DateTime?
  venue        String
  address      String
  mapsUrl      String?
  dressCode    String?
  sortOrder    Int                @default(0)
  translations EventTranslation[]
  attendance   EventAttendance[]
}

model EventTranslation {
  eventId     String
  locale      Locale
  name        String
  description String?
  event       Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, locale])
}

model Invitation {
  id                 String    @id @default(cuid())
  token              String    @unique
  email              String    @unique
  locale             Locale    @default(en)
  companionAllowance Int       @default(0)
  respondedAt        DateTime?
  note               String?
  songRequest        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  guests             Guest[]
  emails             EmailLog[]
}

model Guest {
  id           String            @id @default(cuid())
  invitationId String
  firstName    String
  lastName     String
  kind         GuestKind         @default(ADULT)
  email        String?
  phone        String?
  dietary      String?
  addedByGuest Boolean           @default(false)
  invitation   Invitation        @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  attendance   EventAttendance[]
}

model EventAttendance {
  guestId String
  eventId String
  status  Attendance @default(PENDING)
  guest   Guest      @relation(fields: [guestId], references: [id], onDelete: Cascade)
  event   Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([guestId, eventId])
}

model EmailLog {
  id           String     @id @default(cuid())
  invitationId String
  kind         EmailKind
  resendId     String?
  error        String?
  sentAt       DateTime   @default(now())
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
}

model SiteContent {
  id           Int                      @id @default(1)
  heroImageUrl String?
  galleryUrls  String[]                 @default([])
  theme        SiteTheme                @default(EDITORIAL)
  updatedAt    DateTime                 @updatedAt
  translations SiteContentTranslation[]

  /// Site-wide effects, edited on `/admin/website/effects`: the first-load cover animation, the
  /// ambient particle layer, and an optional background-music track (an https audio URL, usually
  /// a Blob upload) that guests can toggle from the floating music button.
  openingAnimation OpeningAnimation @default(SEAL)
  particlesEnabled Boolean          @default(true)
  musicUrl         String?

  /// Tuning knobs for the same page, clamped by `src/domain/effects-settings.ts`: how long the
  /// cover holds before offering its button, the reveal speed (percent), how many particles a
  /// burst has, how many seconds it lasts before fading (0 = never), and their speed (percent).
  openingHoldSeconds Int @default(2)
  openingSpeed       Int @default(100)
  particleCount      Int @default(30)
  particleSeconds    Int @default(6)
  particleSpeed      Int @default(100)

  /// Which generation of stand-in photography the deploy seed has applied, so it fills a site
  /// once and then leaves every image alone — including a deliberate removal of all photos.
  /// See `prisma/content-seed.ts`.
  placeholderPhotoGeneration Int @default(0)
}

model SiteContentTranslation {
  siteContentId Int
  locale        Locale
  tagline       String      @default("")
  storyIntro    String      @default("")
  rsvpNote      String      @default("")
  siteContent   SiteContent @relation(fields: [siteContentId], references: [id], onDelete: Cascade)

  @@id([siteContentId, locale])
}

model StoryMilestone {
  id           String                        @id @default(cuid())
  sortOrder    Int                           @default(0)
  dateLabel    String
  imageUrl     String?
  translations StoryMilestoneTranslation[]
}

model StoryMilestoneTranslation {
  milestoneId String
  locale      Locale
  title       String
  body        String
  milestone   StoryMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@id([milestoneId, locale])
}
