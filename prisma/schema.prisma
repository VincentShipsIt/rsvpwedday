datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum Locale {
  en
  de
  ku
}

enum GuestKind {
  ADULT
  CHILD
}

enum Attendance {
  PENDING
  ACCEPTED
  DECLINED
}

enum EmailKind {
  INVITE
  REMINDER
  CONFIRMATION
  /// Sent on the day, pointing guests at their photo book instead of the RSVP form.
  PHOTOS
}

enum SiteTheme {
  EDITORIAL
  MODERN
  GARDEN
  MIDNIGHT
  BOHO
  VINTAGE
  MEDITERRANEAN
}

/// The first-load cover a guest sees before the page (see `src/components/site/opening`).
/// `NONE` skips it entirely; the other three are alternative SVG animations of the same cover.
enum OpeningAnimation {
  NONE
  SEAL
  MONOGRAM
  BLOOM
}

model Settings {
  id           Int      @id @default(1)
  coupleNames  String
  rsvpDeadline DateTime
  replyTo      String?
  updatedAt    DateTime @updatedAt

  /// The ceremony itself: what the countdown counts to, and what "the day" means everywhere else.
  /// Events keep their own absolute `startsAt` and are not derived from this — a henna night the
  /// evening before and a brunch the morning after are ordinary events, not exceptions. Optional
  /// so an existing database keeps working: until it is set, `src/domain/wedding-date.ts` falls
  /// back to the earliest event by date.
  weddingDate  DateTime?
}

model Event {
  id           String             @id @default(cuid())
  slug         String             @unique
  startsAt     DateTime
  endsAt       DateTime?
  venue        String
  address      String
  mapsUrl      String?
  dressCode    String?
  sortOrder    Int                @default(0)

  /// Whether the public site lists this event at all. Off, it disappears from the `EVENTS` block
  /// that anyone can read, while the guests actually invited to it still see it on their own RSVP
  /// page and in their invitation email — those two filter by attendance rows, never by this. It
  /// is how a family-only welcome dinner stops being an announcement to everybody else. Default
  /// on, so every event that already exists keeps behaving exactly as it did.
  showPublicly Boolean            @default(true)

  translations EventTranslation[]
  attendance   EventAttendance[]
}

model EventTranslation {
  eventId     String
  locale      Locale
  name        String
  description String?
  event       Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, locale])
}

model Invitation {
  id                 String     @id @default(cuid())
  token              String     @unique
  email              String     @unique
  locale             Locale     @default(en)
  companionAllowance Int        @default(0)
  respondedAt        DateTime?
  note               String?
  songRequest        String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  guests             Guest[]
  emails             EmailLog[]
  photos             Photo[]
  giftClaims         GiftClaim[]
}

model Guest {
  id           String            @id @default(cuid())
  invitationId String
  firstName    String
  lastName     String
  kind         GuestKind         @default(ADULT)
  email        String?
  phone        String?
  dietary      String?
  addedByGuest Boolean           @default(false)
  invitation   Invitation        @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  attendance   EventAttendance[]
}

model EventAttendance {
  guestId String
  eventId String
  status  Attendance @default(PENDING)
  guest   Guest      @relation(fields: [guestId], references: [id], onDelete: Cascade)
  event   Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([guestId, eventId])
}

// Per-kind, per-locale overrides for the transactional emails. An empty string keeps the
// dictionary's default for that field, so a fresh database sends the built-in copy.
model EmailTemplate {
  kind    EmailKind
  locale  Locale
  subject String    @default("")
  heading String    @default("")
  body    String    @default("")

  @@id([kind, locale])
}

model EmailLog {
  id           String     @id @default(cuid())
  invitationId String
  kind         EmailKind
  resendId     String?
  error        String?
  sentAt       DateTime   @default(now())
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
}

/// One guest-uploaded photo in the shared memories book. Attribution is the name the uploader
/// picked from their own household when adding it, denormalised so a photo keeps its caption line
/// even if that guest row is later edited or removed; `invitationId` is the household that added
/// it, which is what the admin moderates by. `hiddenAt` takes a photo out of the book without
/// destroying it — deleting is a separate, deliberate action.
model Photo {
  id           String     @id @default(cuid())
  invitationId String
  url          String
  uploaderName String     @default("")
  caption      String     @default("")
  hiddenAt     DateTime?
  createdAt    DateTime   @default(now())
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([invitationId])
}

model SiteContent {
  id           Int                      @id @default(1)
  heroImageUrl String?
  galleryUrls  String[]                 @default([])
  theme        SiteTheme                @default(EDITORIAL)
  updatedAt    DateTime                 @updatedAt
  translations SiteContentTranslation[]

  /// Site-wide effects, edited on `/admin/settings/effects`: the first-load cover animation, the
  /// ambient particle layer, and an optional background-music track (an https audio URL, usually
  /// a Blob upload) that guests can toggle from the floating music button.
  openingAnimation OpeningAnimation @default(BLOOM)
  particlesEnabled Boolean          @default(true)
  musicUrl         String?

  /// Tuning knobs for the same page, clamped by `src/domain/effects-settings.ts`: how long the
  /// cover holds before offering its button, the reveal speed (percent), how many particles a
  /// burst has, how many seconds it lasts before fading (0 = never), their speed (percent), and
  /// how loud the background music plays (percent of full volume).
  openingHoldSeconds Int @default(2)
  openingSpeed       Int @default(100)
  particleCount      Int @default(30)
  particleSeconds    Int @default(6)
  particleSpeed      Int @default(100)
  musicVolume        Int @default(40)

  /// The guest photo book at `/rsvp/<token>/memories`, edited on `/admin/memories`.
  /// `photosEnabled` is the master switch: off, the book 404s and nothing links to it. With it on,
  /// uploads open once `photosOpenAt` has passed (null = no gate), so the couple can set the
  /// wedding day and forget it. `photosTestMode` opens the book right now regardless, which is how
  /// they try it out beforehand without disturbing the real date.
  photosEnabled  Boolean   @default(false)
  photosOpenAt   DateTime?
  photosTestMode Boolean   @default(false)

  /// Which generation of stand-in photography the deploy seed has applied, so it fills a site
  /// once and then leaves every image alone — including a deliberate removal of all photos.
  /// See `prisma/content-seed.ts`.
  placeholderPhotoGeneration Int @default(0)
}

model SiteContentTranslation {
  siteContentId  Int
  locale         Locale
  tagline        String      @default("")
  storyIntro     String      @default("")
  rsvpNote       String      @default("")
  // Section headings; an empty string falls back to the dictionary's default for that locale.
  storyHeading   String      @default("")
  eventsHeading  String      @default("")
  galleryHeading String      @default("")
  rsvpHeading    String      @default("")
  /// Heading and intro of the `/guide` page, also reused by the home-page teaser and as the
  /// nav label when set (the dictionary's generic "Travel guide" is the fallback).
  guideTitle     String      @default("")
  guideIntro     String      @default("")
  /// Cover title and opening note of the photo book; empty falls back to the dictionary.
  photosTitle    String      @default("")
  photosIntro    String      @default("")
  siteContent    SiteContent @relation(fields: [siteContentId], references: [id], onDelete: Cascade)

  @@id([siteContentId, locale])
}

model StoryMilestone {
  id           String                      @id @default(cuid())
  sortOrder    Int                         @default(0)
  dateLabel    String
  imageUrl     String?
  translations StoryMilestoneTranslation[]
}

model StoryMilestoneTranslation {
  milestoneId String
  locale      Locale
  title       String
  body        String
  milestone   StoryMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@id([milestoneId, locale])
}

/// One anchored block on the public `/guide` page (getting there, where to stay, ...). Empty
/// table = no guide: the nav link, the home-page teaser, and the route's content all hide.
model GuideSection {
  id           String                    @id @default(cuid())
  slug         String                    @unique
  sortOrder    Int                       @default(0)
  imageUrl     String?
  translations GuideSectionTranslation[]
  items        GuideItem[]
}

model GuideSectionTranslation {
  sectionId String
  locale    Locale
  title     String
  intro     String       @default("")
  section   GuideSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([sectionId, locale])
}

/// A card inside a guide section: a hotel, an airline, a beach, a tip. `url` is optional so a
/// plain piece of advice renders without a link.
model GuideItem {
  id           String                 @id @default(cuid())
  sectionId    String
  sortOrder    Int                    @default(0)
  url          String?
  imageUrl     String?
  section      GuideSection           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  translations GuideItemTranslation[]
}

model GuideItemTranslation {
  itemId String
  locale Locale
  title  String
  body   String    @default("")
  item   GuideItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([itemId, locale])
}

model FaqEntry {
  id           String                @id @default(cuid())
  sortOrder    Int                   @default(0)
  translations FaqEntryTranslation[]
}

model FaqEntryTranslation {
  entryId  String
  locale   Locale
  question String
  answer   String
  entry    FaqEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@id([entryId, locale])
}

/// One entry on the couple's wish list: a present, or a share of the honeymoon. Nothing here says
/// which — a registry becomes a honeymoon registry through the block's own heading and intro and
/// each entry's own words, so the couple can run either without a second table or a mode switch.
model Gift {
  id        String  @id @default(cuid())
  sortOrder Int     @default(0)
  imageUrl  String?
  /// Where to buy it, or read about the experience. Optional: "a night of the hotel" needs no link.
  url       String?
  /// Free text, not a number: "€120", "about 80 francs" and "" all have to read naturally, and a
  /// family site has no business modelling currency.
  price     String  @default("")

  claim        GiftClaim?
  translations GiftTranslation[]

  @@index([sortOrder])
}

model GiftTranslation {
  giftId String
  locale Locale
  title  String @default("")
  /// Rich text, like every other guest-facing description.
  body   String @default("")
  gift   Gift   @relation(fields: [giftId], references: [id], onDelete: Cascade)

  @@id([giftId, locale])
}

/// Who is bringing a gift. `giftId` is the primary key, so "one gift, one taker" is the database's
/// own rule rather than a check every action has to remember: two guests reserving the same entry
/// in the same second cannot both win, and the loser is told so. `guestName` is the name the
/// reserver picked from their own household, denormalised the way a photo's uploader is, so the
/// couple's overview still reads correctly after that guest row is renamed or removed.
model GiftClaim {
  giftId       String   @id
  invitationId String
  guestName    String   @default("")
  /// An optional word for the couple, shown only in the admin: this is a gift, not a comment feed.
  message      String   @default("")
  createdAt    DateTime @default(now())

  gift       Gift       @relation(fields: [giftId], references: [id], onDelete: Cascade)
  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
}

/// What a block renders. The built-in sections read their data from the tables above (events,
/// milestones, settings, gifts) or from the block itself (hero photo and tagline, gallery photos,
/// FAQ items, RSVP note) and can be reordered like any other block. The rest are free content the
/// couple adds anywhere: a rich-text block, a card grid (a guide section), one picture, or a
/// teaser linking to another page.
enum BlockType {
  HERO
  STORY
  EVENTS
  GALLERY
  FAQ
  RSVP
  TEXT
  CARDS
  IMAGE
  PAGE_LINK
  GIFTS
}

/// A public page. `home` is the root route; any other slug is served at `/<slug>`. Pages with no
/// blocks that render anything hide from the nav and 404, so an empty page never gets a link.
model Page {
  id           String            @id @default(cuid())
  slug         String            @unique
  sortOrder    Int               @default(0)
  showInNav    Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  translations PageTranslation[]
  blocks       Block[]
}

model PageTranslation {
  pageId String
  locale Locale
  /// Nav label and page heading; the dictionary's generic label is the fallback.
  title  String @default("")
  /// Shown under the heading on a non-home page.
  intro  String @default("")
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@id([pageId, locale])
}

/// One block on a page, edited on its own in `/admin/pages/<id>` so saving one can never touch
/// another. `anchor` is the `#fragment` the nav links to (empty = no link). Which of the optional
/// columns a block uses depends on its `type`; see `src/domain/blocks.ts`.
model Block {
  id           String             @id @default(cuid())
  pageId       String
  sortOrder    Int                @default(0)
  type         BlockType
  anchor       String             @default("")
  imageUrl     String?
  imageUrls    String[]           @default([])
  /// PAGE_LINK: the target path (`/guide`); CARDS items carry their own links instead.
  url          String?
  page         Page               @relation(fields: [pageId], references: [id], onDelete: Cascade)
  translations BlockTranslation[]
  items        BlockItem[]
}

model BlockTranslation {
  blockId String
  locale  Locale
  /// Heading (or the hero tagline, or an image caption). Empty falls back to the dictionary.
  title   String @default("")
  /// Rich text: the story intro, the RSVP note, a text block, a card grid's intro.
  body    String @default("")
  block   Block  @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@id([blockId, locale])
}

/// A card inside a CARDS block (a hotel, a beach) or a question inside a FAQ block.
model BlockItem {
  id           String                 @id @default(cuid())
  blockId      String
  sortOrder    Int                    @default(0)
  url          String?
  imageUrl     String?
  block        Block                  @relation(fields: [blockId], references: [id], onDelete: Cascade)
  translations BlockItemTranslation[]
}

model BlockItemTranslation {
  itemId String
  locale Locale
  title  String    @default("")
  body   String    @default("")
  item   BlockItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([itemId, locale])
}
